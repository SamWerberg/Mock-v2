Toggle.TextSize = 14
Instance.new("UICorner", Toggle)

local ENABLED = false
local TARGET_NAME = ""

local CurrentCommentIndex = 1

local function getComments()
	local comments = {}

	for _, box in ipairs(CommentBoxes) do
		local text = box.Text

		if text and text:gsub("%s+", "") ~= "" then
			table.insert(comments, text)
		end
	end

	return comments
end

Toggle.MouseButton1Click:Connect(function()
	ENABLED = not ENABLED

	Toggle.Text = ENABLED and "ON" or "OFF"
	Toggle.BackgroundColor3 =
		ENABLED
		and Color3.fromRGB(150,0,0)
		or Color3.fromRGB(80,0,0)

	TARGET_NAME = NameBox.Text

	CurrentCommentIndex = 1
end)

local function findPlayer(input)
	input = string.lower(input)

	for _, p in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(p.Name), input)
		or string.find(string.lower(p.DisplayName), input) then
			return p
		end
	end
end

TextChatService.OnIncomingMessage = function(message)
	if not ENABLED then
		return
	end

	if message.TextSource then
		local player = Players:GetPlayerByUserId(message.TextSource.UserId)

		if player and player ~= LocalPlayer then
			local target = findPlayer(TARGET_NAME)

			if target and player == target then

				local comments = getComments()

				if #comments == 0 then
					return
				end

				local COMMENT = comments[CurrentCommentIndex]

				CurrentCommentIndex += 1

				if CurrentCommentIndex > #comments then
					CurrentCommentIndex = 1
				end

				local final = '"' .. message.Text .. '" ' .. COMMENT

				TextChatService.TextChannels.RBXGeneral:SendAsync(final)
			end
		end
	end
end
