local CommentBoxes = {}

local function createCommentBox(defaultText)
	local Box = Instance.new("TextBox")
	Box.Parent = CommentScroll

	Box.Size = UDim2.new(1,-12,0,30)
	Box.BackgroundColor3 = Color3.fromRGB(30,0,0)
	Box.TextColor3 = Color3.new(1,1,1)
	Box.PlaceholderText = defaultText or "Your Comment"
	Box.Text = ""
	Box.Font = Enum.Font.Gotham
	Box.TextSize = 14
	Box.ClearTextOnFocus = false

	Instance.new("UICorner", Box)

	table.insert(CommentBoxes, Box)

	return Box
end

createCommentBox("Your Comment")

